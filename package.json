{
  "name": "@htochko/morph-countdown",
  "version": "1.0.0-beta.8",
  "description": "Modular SVG matrix-morphing countdown component with tree-shaking support and custom vector themes",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/morph-countdown.js",
      "style": "./dist/morph-countdown.css"
    },
    "./morph-countdown.css": {
      "style": "./dist/morph-countdown.css",
      "import": "./dist/morph-countdown.css"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js"
    },
    "./i18n/*": {
      "types": "./dist/i18n/*.d.ts",
      "import": "./dist/i18n/*.js"
    }
  },
  "main": "./dist/morph-countdown.js",
  "style": "./dist/morph-countdown.css",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint src/**/*.ts",
    "test": "node --test --import tsx/esm tests/*.test.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "keywords": [
    "countdown",
    "svg",
    "animation",
    "matrix-morphing",
    "typescript",
    "tree-shaking"
  ]
}
