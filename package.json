{
  "name": "morph-countdown",
  "version": "1.0.0-beta.2",
  "description": "Modular SVG matrix-morphing countdown component with tree-shaking support and custom vector themes",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js"
    },
    "./i18n/*": {
      "types": "./dist/i18n/*.d.ts",
      "import": "./dist/i18n/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "test": "node --test --import tsx/esm tests/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "keywords": [
    "countdown",
    "svg",
    "animation",
    "matrix-morphing",
    "typescript",
    "tree-shaking"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
